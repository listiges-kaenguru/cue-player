{
  "name": "cue-player",
  "version": "0.7.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/listiges-kaenguru/cue-player.git"
  },
  "description": "Show-Player (PWA) für Theater, Events und Live-Sound",
  "type": "module",
  "scripts": {
    "start": "http-server -p 8080 -c-1",
    "test": "node tests/smoke.mjs",
    "test:unit": "node --test 'tests/unit/*.test.mjs'",
    "test:import": "node tests/import.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='js/**' 'tests/unit/*.test.mjs'",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "http-server": "^14.1.1",
    "playwright": "^1.56.1"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  }
}
